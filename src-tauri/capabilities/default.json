{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ana (launcher) pencere: tüm uygulama komutları",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-get-state",
    "allow-set-enabled",
    "allow-set-settings",
    "allow-open-play",
    "allow-close-play",
    "allow-open-bx-settings",
    "allow-apply-recommended",
    "allow-open-support",
    "updater:default",
    "process:allow-restart"
  ]
}
